<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="trading-container">
        <header>
            <div class="ticker">BTC/USD <span id="price">$64,230.50</span></div>
        </header>
        <main>
            <div class="chart-area">
                <!-- Placeholder for Charting Library like Lightweight Charts -->
                <div class="chart-placeholder">Interactive Chart Area</div>
            </div>
            <aside class="order-entry">
                <div class="tabs"><button class="active">Buy</button><button>Sell</button></div>
                <input type="number" placeholder="Amount (BTC)">
                <button class="submit-btn">Place Order</button>
            </aside>
        </main>
    </div>
    <script src="script.js"></script>
</body>
</html>
